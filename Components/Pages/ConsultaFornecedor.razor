@page "/ConsultaFornecedor"

@using AppBugaoMotoFVLE.Components.Models;
@inject FornecedorDAO fornecedorDAO

<div class="container-md pt-3">
    <div class="breadcrumb">
        <a href="/"> Home </a> • <a>Consultar Fornecedor</a>
    </div>
    <div class="border p-4 rounded">
        <h2>Consultar Fornecedor 🔍</h2>

        <div class="search-bar">
            <input type="text" placeholder="Buscar">
            <button class="btn btn-filter"><i class="fa-solid fa-filter"></i> Filtrar</button>
            <a href="/CadastroFornecedor" class="btn btn-add"><i class="fi fi-sr-user-add"></i> Adicionar novo Fornecedor</a>
        </div>

        <table>
            <thead>
                <tr>
                    <th> # </th>
                    <th>Empresa</th>
                    <th>Responsavel</th>
                    <th>Contato</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int contador = 1;
                    @foreach (var fornecedor in listaFornecedor)
                    {
                        <tr>
                            <td> @contador </td>
                            <td> @fornecedor.RazaoSocial </td>
                            <td> @fornecedor.Responsavel </td>
                            <td> @fornecedor.TelefoneEmp </td>
                            @*<td>
                                <button class="btn-view"><i class="fi fi-rr-eye"></i></button>
                            </td>*@

                            <form action="/fornecedor/@fornecedor.Id/editar" method="post">
                                <input type="hidden" name="_method" value="PUT" />  <!-- Simula o método PUT -->

                                <div class="form-group">
                                    <label for="nome_forne">Nome do Fornecedor</label>
                                    <input type="text" class="form-control" id="nome_forne" name="nome_forne" value="@fornecedor.Nome" required>
                                </div>

                                <div class="form-group">
                                    <label for="nome_responsa_forne">Responsável</label>
                                    <input type="text" class="form-control" id="nome_responsa_forne" name="nome_responsa_forne" value="@fornecedor.Responsavel" required>
                                </div>

                                <div class="form-group">
                                    <label for="telefone_forne">Telefone</label>
                                    <input type="tel" class="form-control" id="telefone_forne" name="telefone_forne" value="@fornecedor.TelefoneEmp" required>
                                </div>

                                <div class="form-group">
                                    <label for="cnpj_forne">CNPJ</label>
                                    <input type="text" class="form-control" id="cnpj_forne" name="cnpj_forne" value="@fornecedor.CNPJ" required>
                                </div>

                                <div class="form-group">
                                    <label for="cep_forne">CEP</label>
                                    <input type="text" class="form-control" id="cep_forne" name="cep_forne" value="@fornecedor.CEP" required>
                                </div>

                                <!-- Adicione outros campos conforme necessário, como endereço, cidade, estado, etc. -->

                                <button type="submit" class="btn btn-primary">Atualizar Fornecedor</button>
                            </form>

                            <form action="/fornecedor/@fornecedor.Id/excluir" method="post" onsubmit="return confirm('Tem certeza que deseja excluir este fornecedor?');">
                                <input type="hidden" name="_method" value="DELETE" />
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Excluir
                                </button>
                            </form>

                        </tr>
                        contador ++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Fornecedor> listaFornecedor = new();


    protected override void OnInitialized()
    {
        CarregarFornecedor();
    }

    private void CarregarFornecedor()
    {
        listaFornecedor = fornecedorDAO.ListarFornecedores();
    }
}

