@page "/"

<div class="home-container">
    <!-- Imagem de fundo -->
    <div class="background-image">
        <img src="/Motos.jpg" alt="Imagem de Moto" class="background-img" />
    </div>

    <!-- Conteúdo principal -->
    <div class="content-section">
        <h1 class="title">Sistema de Gestão Bugão Motos</h1>
        <p class="subtitle">Selecione uma das opções abaixo</p>

        <div class="buttons-container">
            <a href="/CadastroProduto" class="btn-interactive">Cadastrar Produto</a>
            <a href="/CadastroCliente" class="btn-interactive">Cadastrar Cliente</a>
            <a href="/ConsultaProduto" class="btn-interactive">Consultar Produtos</a>
            <a href="/ConsultaCliente" class="btn-interactive">Consultar Clientes</a>
        </div>
    </div>
</div>

<style>
    /* Container geral */
    .home-container {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Imagem de fundo */
    .background-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        overflow: hidden;
    }

    .background-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.4);
    }

    /* Conteúdo sobreposto */
    .content-section {
        text-align: center;
        color: #fff;
        padding: 20px;
        animation: fadeIn 1.2s ease;
    }

    .title {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 10px;
        text-shadow: 3px 3px 8px #000;
    }

    .subtitle {
        font-size: 1.3rem;
        margin-bottom: 30px;
        text-shadow: 2px 2px 6px #000;
    }

    /* Botões */
    .buttons-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center;
    }

    .btn-interactive {
        padding: 15px 25px;
        font-size: 1.2rem;
        font-weight: 600;
        background: #c40000;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        transition: 0.3s;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }

        .btn-interactive:hover {
            background: #ff1a1a;
            transform: scale(1.08);
            box-shadow: 0 6px 15px rgba(0,0,0,0.5);
        }

    /* Animação suave */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
