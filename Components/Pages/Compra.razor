@page "/venda"
@inject ServicoDAO servicoDAO
@inject ProdutoDAO produtoDAO
@inject ClienteDAO clienteDAO
@inject VendaDAO vendaDAO

<h1 class="border-start ps-4 mt-4">Venda</h1>

<div class="container-md pt-4 d-grid gap-4">

    <!-- Abas -->
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#tabServico">Adicionar Serviços</a>
        </li>

        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#tabProduto">Adicionar Produtos</a>
        </li>

        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#tabPagamento">Pagamento</a>
        </li>
    </ul>

    <!-- Conteúdo -->
    <div class="tab-content border">

        <!-- ====================== SERVIÇO ====================== -->
        <div class="tab-pane fade show active p-4" id="tabServico">

            <div class="border-start ps-4">
                <h2>Adicionar Serviços</h2>
                <p>Selecione o serviço prestado</p>
            </div>

            <div class="row">
                <div class="col-4">
                    <select class="form-select" @bind="servicoSelecionadoId">
                        <option value="">Selecione...</option>
                        @foreach (var s in servicos)
                        {
                            <option value="@s.IdSer">@s.Nome (@s.Valor:C)</option>
                        }
                    </select>
                </div>

                <div class="col-4 d-grid">
                    <button class="btn btn-success" @onclick="AdicionarServico">
                        Adicionar Serviço
                    </button>
                </div>
            </div>

            <!-- Tabela Serviços -->
            <table class="table mt-3 table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Serviço</th>
                        <th>Valor</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var s in servicosVenda)
                    {
                        <tr>
                            <td>@s.Servico</td>
                            <td>@s.Servico</td>
                            <td>@s.Valor:C</td>
                            <td>
                                <button class="btn btn-sm btn-danger" @onclick="@(() => RemoverServico(s))">
                                    Remover
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <button class="btn btn-dark mt-3" data-bs-target="#tabProduto" data-bs-toggle="tab">
                Próximo →
            </button>

        </div>

        <!-- ======================= PRODUTO ======================= -->
        <div class="tab-pane fade p-4" id="tabProduto">

            <div class="border-start ps-4">
                <h2>Adicionar Produtos</h2>
            </div>

            <div class="row">
                <div class="col-4">
                    <select class="form-select" @bind="produtoSelecionadoId">
                        <option value="">Selecione...</option>
                        @foreach (var p in produtos)
                        {
                            <option value="@p.IdProduto">@p.Nome (@p.Valor:C)</option>
                        }
                    </select>
                </div>

                <div class="col-2">
                    <input type="number" class="form-control"
                           placeholder="Qtd" @bind="quantidadeProduto" min="1" />
                </div>

                <div class="col-4 d-grid">
                    <button class="btn btn-success" @onclick="AdicionarProduto">
                        Adicionar Produto
                    </button>
                </div>
            </div>

            <!-- Tabela Produto -->
            <table class="table mt-3 table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Produto</th>
                        <th>Qtd</th>
                        <th>Unitário</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in produtosVenda)
                    {
                        <tr>
                            <td>@p.Produto</td>
                            <td>@p.Quantidade</td>
                            <td>@p.ValorUnitario:C</td>
                            <td>@p.ValorTotal:C</td>
                            <td>
                                <button class="btn btn-sm btn-danger" @onclick="@(() => RemoverProduto(p))">
                                    Remover
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <button class="btn btn-dark mt-3" data-bs-target="#tabPagamento" data-bs-toggle="tab">
                Próximo →
            </button>

        </div>

        <!-- ======================= PAGAMENTO ======================= -->
        <div class="tab-pane fade p-4" id="tabPagamento">

            <div class="border-start ps-4">
                <h2>Pagamento</h2>
            </div>

            <div class="row mt-4">
                <div class="col-4">
                    <label>Data</label>
                    <input type="date" class="form-control" @bind="dataVenda" />
                </div>

                <div class="col-4">
                    <label>Cliente</label>
                    <select class="form-select" @bind="clienteSelecionadoId">
                        <option value="">Selecione...</option>
                        @foreach (var c in clientes)
                        {
                            <option value="@c.IdCli">@c.Nome</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mt-4 row p-3 border rounded bg-light">
                <div class="col-6">
                    <p>Total Serviços:</p>
                    <p>Total Produtos:</p>
                    <hr />
                    <p><b>Total Geral:</b></p>
                </div>

                <div class="col-6 text-end">
                    <p>@totalServicos:C</p>
                    <p>@totalProdutos:C</p>
                    <hr />
                    <p><b>@(totalServicos + totalProdutos):C</b></p>
                </div>
            </div>

            <button class="btn btn-success mt-3 w-100" @onclick="FinalizarVenda">
                Finalizar Venda ✔
            </button>

        </div>

    </div>
</div>

@code {

    // ========= CARREGAMENTO ===========
    List<Servico> servicos = new();
    List<Produto> produtos = new();
    List<Cliente> clientes = new();

    // ========= VENDA ===========
    List<VendaServico> servicosVenda = new();
    List<VendaProduto> produtosVenda = new();

    string? servicoSelecionadoId;
    string? produtoSelecionadoId;
    string? clienteSelecionadoId;

    int quantidadeProduto = 1;
    DateTime dataVenda = DateTime.Today;

    double totalServicos = 0;
    double totalProdutos = 0;

    protected override async Task OnInitializedAsync()
    {
        servicos = servicoDAO.ListarTodos();
        produtos = produtoDAO.ListarTodos();
        clientes = clienteDAO.ListarCliente();
    }

    // ========= ADICIONAR SERVIÇO ===========
    void AdicionarServico()
    {
        var s = servicos.FirstOrDefault(x => x.IdSer.ToString() == servicoSelecionadoId);
        if (s == null) return;

        servicosVenda.Add(new VendaServico
            {
                Servico = s.Nome,
                Valor = s.Valor,
                Status = true
            });

        totalServicos += s.Valor;
    }

    void RemoverServico(VendaServico s)
    {
        servicosVenda.Remove(s);
        totalServicos -= s.Valor;
    }

        // ========= ADICIONAR PRODUTO ===========
    void AdicionarProduto()
    {
        var p = produtos.FirstOrDefault(x => x.IdProduto.ToString() == produtoSelecionadoId);
        if (p == null) return;

        double valorUnitario = Convert.ToDouble(p.Valor);  
        double valorTotal = quantidadeProduto * valorUnitario;

        var novo = new VendaProduto
            {
                Produto = p.Nome,
                Quantidade = quantidadeProduto,
                ValorUnitario = valorUnitario,
                ValorTotal = valorTotal,
                Status = true
            };

        produtosVenda.Add(novo);
        totalProdutos += novo.ValorTotal;
    }

    void RemoverProduto(VendaProduto p)
    {
        produtosVenda.Remove(p);
        totalProdutos -= p.ValorTotal;
    }


    async Task FinalizarVenda()
    {
        var venda = new Venda
            {
                DataVenda = dataVenda,
                ValorTotal = totalServicos + totalProdutos
            };

        int idVenda = vendaDAO.CriarVenda(venda);

        foreach (var s in servicosVenda)
        {
            s.IdVenda = idVenda;
            vendaDAO.SalvarServico(s);
        }

        foreach (var p in produtosVenda)
        {
            p.IdVenda = idVenda;
            vendaDAO.SalvarProduto(p);
        }
    }

}
