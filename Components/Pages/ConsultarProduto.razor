@page "/ConsultarProduto"

@using AppBugaoMotoFVLE.Components.Models;
@inject ProdutoDAO ProdutoDAO

<div class="container-md pt-3">
    <div class="breadcrumb">
        <a href="/"> Home </a> • <a> Consultar Produto </a>
    </div>

    <div class="border p-4 rounded">
        <h2>Consultar Produto 🛒</h2>

        <div class="search-bar">
            <input type="text" placeholder="Buscar produto">
            <button class="btn btn-filter"><i class="fa-solid fa-filter"></i> Filtrar</button>
            <a href="/CadastroProduto" class="btn btn-add">
                <i class="fi fi-sr-add-document"></i> Adicionar novo produto
            </a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nome</th>
                    <th>Código</th>
                    <th>Quantidade</th>
                    <th>Valor</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int contador = 1;

                    foreach (var produto in listaProdutos)
                    {
                        <tr>
                            <td>@contador</td>
                            <td>@produto.Nome</td>
                            <td>@produto.Codigo</td>
                            <td>@produto.Quantidade</td>
                            <td>R$ @produto.Valor</td>

                            <td>
                                <!-- OLHINHO -->
                                <button class="btn-view" @onclick="() => AbrirVisualizar(produto.IdProduto)">
                                    <i class="fa-solid fa-eye"></i>
                                </button>

                                <!-- EDITAR (abre a modal) -->
                                <button class="btn-edit" @onclick="() => AbrirEditar(produto.IdProduto)">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                            </td>
                        </tr>

                        contador++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (modalAberta)
{
    <div class="modal-bg">
        <div class="modal-box">
            <h3>Editar Produto</h3>

            <label>Nome</label>
            <input class="form-control" @bind="produtoSel.Nome" />

            <label>Código</label>
            <input class="form-control" @bind="produtoSel.Codigo" />

            <label>Quantidade</label>
            <input class="form-control" type="number" @bind="produtoSel.Quantidade" />

            <label>Valor</label>
            <input class="form-control" type="number" step="0.01" @bind="produtoSel.Valor" />

            <div class="modal-buttons">
                <button class="btn-save" @onclick="Salvar">Salvar</button>
                <button class="btn-delete" @onclick="Excluir">Excluir</button>
                <button class="btn-close" @onclick="() => modalAberta = false">Cancelar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Produto> listaProdutos = new();
    private Produto produtoSel = new();
    private bool modalAberta = false;

    protected override void OnInitialized()
    {
        CarregarProdutos();
    }

    private void CarregarProdutos()
    {
        listaProdutos = ProdutoDAO.ListarTodos();
    }

    private void AbrirVisualizar(int id)
    {
        produtoSel = ProdutoDAO.BuscarPorId(id);
        modalAberta = true;
    }

    private void AbrirEditar(int id)
    {
        produtoSel = ProdutoDAO.BuscarPorId(id);
        modalAberta = true;
    }

    private void Salvar()
    {
        ProdutoDAO.Atualizar(produtoSel);
        modalAberta = false;
        CarregarProdutos();
    }

    private void Excluir()
    {
        ProdutoDAO.Excluir(produtoSel.IdProduto);
        modalAberta = false;
        CarregarProdutos();
    }
}
