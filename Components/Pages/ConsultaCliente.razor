@page "/ConsultaCliente"
@using Microsoft.AspNetCore.Components.Forms

@using AppBugaoMotoFVLE.Components.Models;
@inject ClienteDAO ClienteDAO;

<div class="container-md pt-3">
    <div class="breadcrumb">
        <a href="/"> Home </a> • <a> Consultar Cliente </a>
    </div>

    <div class="border p-4 rounded">
        <h2>Consultar Cliente 🔍</h2>

        <div class="search-bar">
            <input type="text" placeholder="Buscar">

            <a href="/CadastroCliente" class="btn btn-add">
                <i class="fi fi-sr-user-add"></i> Adicionar novo cliente
            </a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nome</th>
                    <th>Telefone</th>
                    <th>CPF</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int contador = 1;

                    foreach (var cliente in listaClie)
                    {
                        <tr>
                            <td>@contador</td>
                            <td>@cliente.Nome</td>
                            <td>@cliente.Telefone</td>
                            <td>@cliente.Cpf</td>

                            <td>
                                <!-- VER / EDITAR / EXCLUIR -->
                                <button class="btn-view"
                                        @onclick="() => AbrirFormulario(cliente.IdCliente)">
                                    <i class="fi fi-rr-eye"></i>
                                </button>

                                <button class="btn-edit"
                                        @onclick="() => AbrirFormulario(cliente.IdCliente)">
                                    <i class="fi fi-rr-edit"></i>
                                </button>

                                <button class="btn-delete"
                                        @onclick="() => AbrirFormulario(cliente.IdCliente, true)">
                                    <i class="fi fi-rr-trash"></i>
                                </button>
                            </td>
                        </tr>

                        contador++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>


@if (modalForm)
{
    <div class="modal-bg">
        <div class="modal-box form-modal">

            <div class="modal-header">
                <h3>DADOS DO CLIENTE</h3>
                <button class="close-x" @onclick="FecharModal">X</button>
            </div>

            <div class="modal-body">

                <label>Nome</label>
                <input class="form-control" @bind="clienteSel.Nome" disabled="@somenteExcluir" />

                <label>Telefone</label>
                <input class="form-control" @bind="clienteSel.Telefone" disabled="@somenteExcluir" />

                <label>CPF</label>
                <input class="form-control" @bind="clienteSel.Cpf" disabled="@somenteExcluir" />

            </div>

            <div class="modal-footer">

                @if (!somenteExcluir)
                {
                    <button class="btn-edit" @onclick="SalvarEdicao">Editar</button>
                }

                <button class="btn-delete" @onclick="ExcluirCliente">Excluir</button>

                <button class="btn-close" @onclick="FecharModal">Cancelar</button>

            </div>

        </div>
    </div>
}

@code {
    private List<Cliente> listaClie = new();
    private Cliente clienteSel = new();

    private bool modalForm = false;
    private bool somenteExcluir = false;

    protected override void OnInitialized()
    {
        CarregarCliente();
    }

    private void CarregarCliente()
    {
        listaClie = ClienteDAO.ListarCliente();
    }

    private void AbrirFormulario(int id, bool excluir = false)
    {
        clienteSel = ClienteDAO.BuscarClientePorId(id);
        somenteExcluir = excluir;

        modalForm = true;
    }

    private void FecharModal()
    {
        modalForm = false;
        somenteExcluir = false;
    }

    private void SalvarEdicao()
    {
        ClienteDAO.AtualizarCliente(clienteSel);
        FecharModal();
        CarregarCliente();
    }

    private void ExcluirCliente()
    {
        ClienteDAO.DeletarCliente(clienteSel.IdCliente);
        FecharModal();
        CarregarCliente();
    }
}



<style>
    .modal-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .modal-box {
        background: white;
        padding: 20px;
        width: 600px;
        border-radius: 8px;
        animation: fadeIn .2s ease;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .close-x {
        background: transparent;
        border: none;
        font-size: 22px;
        cursor: pointer;
    }

    .modal-body label {
        margin-top: 10px;
        font-weight: bold;
    }

    .modal-body input {
        margin-bottom: 10px;
    }

    .modal-footer {
        margin-top: 15px;
        display: flex;
        gap: 10px;
    }

    .btn-edit {
        background: #22c55e;
        color: white;
        padding: 8px 20px;
        border-radius: 6px;
    }

    .btn-delete {
        background: #ef4444;
        color: white;
        padding: 8px 20px;
        border-radius: 6px;
    }

    .btn-close {
        background: #6b7280;
        color: white;
        padding: 8px 20px;
        border-radius: 6px;
    }

    table button {
        margin-right: 5px;
        padding: 6px;
        border-radius: 5px;
    }

</style>
