@page "/servico/{Id:int}/editar"
@rendermode InteractiveServer


@inject ServicoDAO servicoDAO;
@inject NavigationManager Navigation;

<PageTitle>Servico</PageTitle>

<h1 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-6">Atualização Serico - @servico.Nome</h1>

@if (erro != string.Empty)
{
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
        <strong class="font-bold">Erro!</strong>
        <span class="block sm:inline">@erro</span>
    </div>
}

<EditForm Model="servico" OnSubmit="Salvar">
    <div class="mb-4">
        <label for="nome" class="block text-sm font-medium text-gray-700">Nome</label>
        <input @bind-value="produto.Nome" type="text" id="nome"
               class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
    </div>
    <div class="mb-4">
        <label for="codigo" class="block text-sm font-medium text-gray-700">Codigo</label>
        <input @bind-value="serico.Codigo" type="number" id="quantidade"
               class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
    </div>
    <div class="mb-4">
        <label for="prestador" class="block text-sm font-medium text-gray-700">Prestador</label>
        <input @bind-value="servico.Prestador" type="text" id="prestador"
               class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
    </div>

    <div class="mb-4">
        <label for="valor" class="block text-sm font-medium text-gray-700">Valor</label>
        <textarea id="valor"
                  class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2">@servico.Valor</textarea>
    </div>

    <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded">Salvar</button>
</EditForm>

@code {

    private string erro = string.Empty;

    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromForm]
    public Produto produto { get; set; } = new();

    protected override void OnInitialized()
    {
        var _servico = servicoDAO.BuscarPorId(Id);

        if (_servico != null)
        {
            servico = _servico;
        }
        else
        {
            erro = "Serviço não encontrado.";
        }
    }

    private void Salvar()
    {
        try
        {
            servicoDAO.Atualizar(servico);

            Navigation.NavigateTo("/servico");
        }
        catch (Exception ex)
        {
            erro = $"Erro ao salvar o serviço: {ex.Message}";
        }

    }

}