@page "/ConsultaProduto"

@using AppBugaoMotoFVLE.Components.Models;
@inject ProdutoDAO ProdutoDAO

<div class="container-md pt-3">
    <div class="breadcrumb">
        <a href="/"> Home </a> • <a> Consultar Produto </a>
    </div>

    <div class="border p-4 rounded">
        <h2>Consultar Produto 🛒</h2>

        <div class="search-bar">
            <input type="text" placeholder="Buscar produto">
            <button class="btn btn-filter"><i class="fa-solid fa-filter"></i> Filtrar</button>
            <a href="/CadastroProduto" class="btn btn-add">
                <i class="fi fi-sr-add-document"></i> Adicionar novo produto
            </a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nome</th>
                    <th>Código</th>
                    <th>Quantidade</th>
                    <th>Valor</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int contador = 1;

                    foreach (var produto in listaProdutos)
                    {
                        <tr>
                            <td>@contador</td>
                            <td>@produto.Nome</td>
                            <td>@produto.Codigo</td>
                            <td>@produto.Quantidade</td>
                            <td>R$ @produto.Valor</td>

                            <td>
                                <a href="/produto/@produto.IdProduto/editar" class="btn btn-sm btn-primary mr-2">
                                    <i class="fas fa-edit"></i> Atualizar
                                </a>
                                <a href="/produto/@produto.IdProduto/excluir" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Excluir
                                </a>
                            </td>
                        </tr>

                        contador++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Produto> listaProdutos = new();
   

    protected override void OnInitialized()
    {
        CarregarProdutos();
    }

    private void CarregarProdutos()
    {
        listaProdutos = ProdutoDAO.ListarTodos();
    }
 


    
}
