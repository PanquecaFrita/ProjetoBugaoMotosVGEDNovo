@page "/cliente/{Id:int}/editar"
@rendermode InteractiveServer

@inject ClienteDAO clienteDAO
@inject NavigationManager Navigation

<PageTitle>Clientes</PageTitle>

<div class="form-container">

    <h1 class="form-title">Atualização Cliente - @cliente.Nome</h1>

    @if (erro != string.Empty)
    {
        <div class="alert-error">
            <strong>Erro:</strong> @erro
        </div>
    }

    <EditForm Model="cliente" OnSubmit="Salvar">

        <div class="input-group">
            <label for="nome">Nome</label>
            <input id="nome" type="text" @bind="cliente.Nome" />
        </div>

        <div class="input-group">
            <label for="telefone">Telefone</label>
            <input id="telefone" type="text" @bind="cliente.Telefone" />
        </div>

        <div class="input-group">
            <label for="estado">Estado</label>
            <input id="estado" type="text" @bind="cliente.Estado" />
        </div>

        <div class="input-group">
            <label for="cidade">Cidade</label>
            <input id="cidade" type="text" @bind="cliente.Cidade" />
        </div>

        <div class="input-group">
            <label for="bairro">Bairro</label>
            <input id="bairro" type="text" @bind="cliente.Bairro" />
        </div>

        <div class="input-group">
            <label for="rua">Rua</label>
            <input id="rua" type="text" @bind="cliente.Rua" />
        </div>

        <div class="input-group">
            <label for="cep">CEP</label>
            <input id="cep" type="text" @bind="cliente.Cep" />
        </div>

        <div class="input-group">
            <label for="complemento">Complemento</label>
            <textarea id="complemento" @bind="cliente.Complemento"></textarea>
        </div>

        <div class="input-group">
            <label for="cpf">CPF</label>
            <input id="cpf" type="text" @bind="cliente.Cpf" />
        </div>

        <button type="submit" class="btn-submit">Salvar</button>

    </EditForm>

</div>

@code {

    private string erro = string.Empty;

    [Parameter]
    public int Id { get; set; }

    public Cliente cliente { get; set; } = new();

    protected override void OnInitialized()
    {
        var _cliente = clienteDAO.BuscarClientePorId(Id);

        if (_cliente != null)
            cliente = _cliente;
        else
            erro = "Cliente não encontrado.";
    }

    private void Salvar()
    {
        try
        {
            clienteDAO.AtualizarCliente(cliente);
            Navigation.NavigateTo("/ConsultaCliente");
        }
        catch (Exception ex)
        {
            erro = $"Erro ao salvar o cliente: {ex.Message}";
        }
    }

}
